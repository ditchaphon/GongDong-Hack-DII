PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL Database (Transaction pooler & Direct)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# LINE Developers Platform
LINE_CHANNEL_ACCESS_TOKEN="your-messaging-api-channel-access-token"
LINE_CHANNEL_SECRET="your-messaging-api-channel-secret"
LINE_LOGIN_CHANNEL_ID="your-line-login-channel-id"
# LIFF app id; notification card buttons open https://liff.line.me/<id>/orders/...
LINE_LIFF_ID="your-liff-id"

# SlipOK API & Platform PromptPay
SLIPOK_API_KEY="your-slipok-api-key"
SLIPOK_BRANCH_ID="your-slipok-branch-id"
PLATFORM_PROMPTPAY_ID="0800000000"
PLATFORM_RECIPIENT_NAME="กองดอง · บัญชีรับชำระ"

# Security & KYC Hashing (HMAC-SHA256 Pepper)
KYC_HASH_PEPPER="replace-with-strong-random-pepper"

# Blacklistseller API (KYC National ID check)
BLACKLISTSELLER_API_KEY="your-blacklistseller-api-key"
BLACKLISTSELLER_API_URL="https://api.blacklistseller.com/api/v1/queries/idcard-summary/"

# Google Books API (optional; prevents HTTP 429 quota exhaustion)
GOOGLE_BOOKS_API_KEY=""
