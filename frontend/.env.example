[TEMPLATE]
# Copy this file to .env.local and fill in your values.
# Never commit .env.local.

# --- LIFF (public) ---
# From LINE Developers -> LINE Login channel -> LIFF app.
NEXT_PUBLIC_LIFF_ID=2000000000-xxxxxxxx
# true = fake user, runs in any browser (development default).
NEXT_PUBLIC_LIFF_MOCK=true

# --- LINE Official Account ---
# Basic ID from LINE OA Manager, WITHOUT the "@" (code adds it).
NEXT_PUBLIC_LINE_OA_ID=848xkfsj

# --- App & Backend API URL (public) ---
# Must be the HTTPS LIFF endpoint URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# For Vercel / single-origin proxy mode, set USE_API_PROXY=true, leave NEXT_PUBLIC_API_URL empty,
# and point BACKEND_INTERNAL_URL to your deployed Backend URL (evaluated at Next.js build time).
# NEXT_PUBLIC_USE_API_PROXY=true
# BACKEND_INTERNAL_URL=https://your-backend.vercel.app

# --- LINE secrets (server-only, never expose to the client) ---
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
